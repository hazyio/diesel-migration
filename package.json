{
  "name": "diesel-migration",
  "displayName": "Diesel Migration",
  "description": "Manage Diesel ORM migrations directly from VS Code — create, run, and revert migrations without leaving your editor.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/hazyio/diesel-migration"
  },
  "publisher": "HazyIo",
  "keywords": [
    "database",
    "diesel",
    "rust",
    "migration",
    "orm"
  ],
  "license": "MIT",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "diesel-migration.setDieselToml",
        "title": "Diesel Migration: Set Diesel Toml Path"
      },
      {
        "command": "diesel-migration.reloadExtension",
        "title": "Diesel Migration: Reload Extension"
      },
      {
        "command": "diesel-migration.setupMigration",
        "title": "Diesel Migration: Setup Migration"
      },
      {
        "command": "diesel-migration.resetDatabase",
        "title": "Diesel Migration: Reset database"
      },
      {
        "command": "diesel-migration.generateMigration",
        "title": "Diesel Migration: Generate migration"
      },
      {
        "command": "diesel-migration.runMigration",
        "title": "Diesel Migration: Run migration"
      },
      {
        "command": "diesel-migration.revertMigration",
        "title": "Diesel Migration: Revert migration"
      },
      {
        "command": "diesel-migration.revertAllMigrations",
        "title": "Diesel Migration: Revert all migrations"
      },
      {
        "command": "diesel-migration.redoMigration",
        "title": "Diesel Migration: Redo migration"
      },
      {
        "command": "diesel-migration.printSchema",
        "title": "Diesel Migration: Print schema"
      },
      {
        "command": "diesel-migration.setDieselTomlFromContext",
        "title": "Diesel Migration: Set as diesel toml path"
      },
      {
        "command": "diesel-migration.resetDatabaseFromContext",
        "title": "Diesel Migration: Reset database"
      },
      {
        "command": "diesel-migration.generateMigrationFromContext",
        "title": "Diesel Migration: Generate migration"
      },
      {
        "command": "diesel-migration.printSchemaFromContext",
        "title": "Diesel Migration: Print schema"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "diesel-migration.setDieselTomlFromContext",
          "when": "false"
        },
        {
          "command": "diesel-migration.resetDatabaseFromContext",
          "when": "false"
        },
        {
          "command": "diesel-migration.generateMigrationFromContext",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "diesel-migration.setDieselTomlFromContext",
          "when": "resourceFilename == diesel.toml && !diesel-migration.canDoOperations",
          "group": "1_diesel-migration@1"
        },
        {
          "command": "diesel-migration.printSchemaFromContext",
          "when": "resourceFilename == diesel.toml && diesel-migration.canDoOperations",
          "group": "1_diesel-migration@2"
        },
        {
          "command": "diesel-migration.resetDatabaseFromContext",
          "when": "resourceFilename == diesel.toml  && diesel-migration.canDoOperations",
          "group": "1_diesel-migration@3"
        },
        {
          "command": "diesel-migration.generateMigrationFromContext",
          "when": "resourceFilename == diesel.toml  && diesel-migration.canDoOperations",
          "group": "1_diesel-migration@4"
        },
        {
          "command": "diesel-migration.runMigration",
          "when": "explorerResourceIsFolder && diesel-migration.canDoOperations && resourceFilename == migrations",
          "group": "1_diesel-migration@5"
        },
        {
          "command": "diesel-migration.redoMigration",
          "when": "explorerResourceIsFolder && diesel-migration.canDoOperations && resourceFilename == migrations",
          "group": "1_diesel-migration@6"
        },
        {
          "command": "diesel-migration.revertMigration",
          "when": "explorerResourceIsFolder && diesel-migration.canDoOperations && resourceFilename == migrations",
          "group": "1_diesel-migration@7"
        },
        {
          "command": "diesel-migration.generateMigration",
          "when": "explorerResourceIsFolder && diesel-migration.canDoOperations && resourceFilename == migrations",
          "group": "1_diesel-migration@8"
        },
        {
          "command": "diesel-migration.revertAllMigrations",
          "when": "explorerResourceIsFolder && diesel-migration.canDoOperations && resourceFilename == migrations",
          "group": "1_diesel-migration@9"
        }
      ]
    },
    "configuration": {
      "properties": {
        "diesel-migration.dieselToml": {
          "type": "string",
          "default": "",
          "description": "Path to diesel.toml, relative to workspace root, if not in the default location."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.134.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "dotenv": "^17.4.2"
  }
}
